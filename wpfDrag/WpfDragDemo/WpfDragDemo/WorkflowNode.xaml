<UserControl x:Class="WpfDragDemo.WorkflowNode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="80">
    <Border Background="LightGray" BorderBrush="DarkGray" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Button x:Name="BtnDelete" Content="X" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2" Foreground="DarkRed" Background="Transparent" BorderBrush="Transparent" Cursor="Hand"/>
            <TextBox x:Name="TextBoxTitle" Text="节点" Margin="10,30,10,10" VerticalContentAlignment="Center" FontSize="14" />
            <Ellipse x:Name="InputPoint" Width="14" Height="14" Fill="DarkGray" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0" Cursor="Cross"/>
            <Ellipse x:Name="OutputPoint" Width="14" Height="14" Fill="DarkGray" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-7,0" Cursor="Cross"/>
        </Grid>
    </Border>
</UserControl>
