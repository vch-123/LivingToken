<Window x:Class="WpfDragDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:local="clr-namespace:WpfDragDemo"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WpfDragDemo" Height="600" Width="900" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="新增节点" Grid.Row="0" Width="100" Height="30" Margin="10" Click="AddNode_Click" />

        <Canvas x:Name="MainCanvas" Grid.Row="1" Background="#F0F0F0"
                MouseLeftButtonDown="MainCanvas_MouseLeftButtonDown"
                MouseMove="MainCanvas_MouseMove"
                MouseLeftButtonUp="MainCanvas_MouseLeftButtonUp"/>
    </Grid>
</Window>
