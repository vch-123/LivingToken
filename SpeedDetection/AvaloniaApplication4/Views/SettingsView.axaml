<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AvaloniaApplication4.ViewModels"
             x:Class="AvaloniaApplication4.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="5*"/>
			<ColumnDefinition Width="5*"/>
		</Grid.ColumnDefinitions>

		<StackPanel Margin="20" Spacing="10">
			<TextBlock Text="选择配色方案:" FontWeight="Bold" FontSize="16" />

			<ComboBox
				ItemsSource="{Binding ColorSchemes}"
				SelectedItem="{Binding SelectedColorScheme, Mode=TwoWay}"
				Width="250">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Name}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<DockPanel Grid.Column="1" Margin="20" VerticalAlignment="Center">
				<TextBlock Text="使用绝对值：" FontSize="16" Margin="-5,24,4,0" VerticalAlignment="Center" />
				<ToggleSwitch
					IsChecked="{Binding UseAbsoluteValue, Mode=TwoWay}"
					Content=""
					Margin="-5,0,0,0"
					VerticalAlignment="Center"
				 />
			</DockPanel>

		</StackPanel>





	</Grid>
	
	



</UserControl>
