<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="clr-namespace:AvaloniaApplication4.ViewModels"
             xmlns:avaloniaControls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             x:Class="AvaloniaApplication4.Views.HomeView"
             x:DataType="vm:HomeViewModel">

	<DockPanel>

		<StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="5" Spacing="8">
			<ToggleButton Content="XS" IsChecked="{Binding XSSelected, Mode=TwoWay}" Width="80" />
			<ToggleButton Content="YS" IsChecked="{Binding YSSelected, Mode=TwoWay}" Width="80" />
			<ToggleButton Content="ZS" IsChecked="{Binding ZSSelected, Mode=TwoWay}" Width="80" />
		</StackPanel>

		<lvc:CartesianChart
			x:Name="MyChart"
            Series="{Binding Series}"
            XAxes="{Binding XAxes}"
            LegendPosition="Top"
            TooltipPosition="Top"
            ZoomMode="X" />
	</DockPanel>
</UserControl>
